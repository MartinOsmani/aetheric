# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# Required. Anthropic Claude is the agent runtime.
ANTHROPIC_API_KEY=

# Default model. claude-opus-4-7 = max intelligence; claude-sonnet-4-6 = faster/cheaper.
AETHERIC_MODEL=claude-opus-4-7

# --- Sponsor APIs ---
# Tavily — live web grounding. Free tier at tavily.com.
TAVILY_API_KEY=

# Thrad — populated on the night if API access is announced.
THRAD_API_KEY=
THRAD_API_URL=

# Overmind — placeholder; their product is mostly UX, mirrored in our cockpit.
OVERMIND_API_KEY=

# --- App ---
APP_ENV=dev
LOG_LEVEL=INFO
APPROVAL_TIMEOUT_SECONDS=120

# CORS origins for the WebSocket / REST surface.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
